<div class="row justify-content-center">
	<div class="col-12 col-lg-8">
		<h1 class="text-center mb-4">Donate</h1>
		<p class="text-center text-muted mb-5">Like the project? Buy me a beer!</p>

		<% if @btc_address.blank? && @ln_address.blank? %>
			<div class="alert alert-warning text-center">
				Donation addresses are not configured yet. Set <code>DONATE_BTC_ADDRESS</code> and/or <code>DONATE_LN_ADDRESS</code> environment variables.
			</div>
		<% end %>

		<div class="row g-4">
			<% if @btc_address.present? %>
				<div class="col-12 col-md-6">
					<div class="card h-100">
						<div class="card-body text-center">
							<h5 class="card-title mb-3">
								<i class="bi bi-link-45deg"></i> On-chain
							</h5>

							<div class="d-flex justify-content-center m-5"
								data-controller="qrcode"
								data-qrcode-data-value="bitcoin:<%= @btc_address %>">
							</div>

							<span><%= @btc_address %></span>
						</div>
					</div>
				</div>
			<% end %>

			<% if @ln_address.present? %>
				<div class="col-12 col-md-6">
					<div class="card h-100">
						<div class="card-body text-center">
							<h5 class="card-title mb-3">
								<i class="bi bi-lightning-fill text-warning"></i> Lightning
							</h5>

							<div class="d-flex justify-content-center m-5"
								data-controller="qrcode"
								data-qrcode-data-value="lightning:<%= @ln_address %>">
							</div>

							<span><%= @ln_address %></span>
						</div>
					</div>
				</div>
			<% end %>
		</div>
	</div>
</div>
